function renderFancam(type){
  const container = document.getElementById('panel-' + type);
  const groups = fancamData[type];

  container.innerHTML = groups.map(g => `
    <details class="song" ${type==='fan'&&g.song==='我最红 (Cover)'?'open':''}>
      <summary>
        <div class="summary-left"><span class="dot"></span><span>${g.song}<span class="ko">${g.songKo}</span></span></div>
        <span class="summary-arrow">▼</span>
      </summary>
      <div class="cam-list">
        ${g.items.map(it => `
          <a class="cam-item" href="${it.link}" target="_blank" rel="noopener">
            <div class="cam-thumb" ${it.thumb ? '' : 'style="background:linear-gradient(135deg,#ff6b4a,#ffc93c);"'}>
              ${it.thumb
                ? `<img src="${it.thumb}" alt="缩略图" referrerpolicy="no-referrer" loading="lazy">`
                : '<span>▶</span>'}
            </div>
            <div class="cam-info">
              <h5>
                ${it.stage}
                <span class="cam-date">${it.date}</span>
                <span class="cam-type">${it.type}</span>
                ${it.play!=='—'?`<span class="cam-play">▶ ${it.play}</span>`:''}
              </h5>
              <p>${it.desc}</p>
            </div>
            <span class="cam-go">去B站 →</span>
          </a>
        `).join('')}
      </div>
    </details>
  `).join('');
}

renderFancam('official');
renderFancam('fan');

document.querySelectorAll('.fancam-tab').forEach(tab=>{
  tab.addEventListener('click', ()=>{
    document.querySelectorAll('.fancam-tab').forEach(t=>t.classList.remove('active'));
    tab.classList.add('active');
    const type = tab.dataset.tab;
    document.getElementById('panel-official').style.display = type==='official' ? 'block' : 'none';
    document.getElementById('panel-fan').style.display = type==='fan' ? 'block' : 'none';
  });
});

