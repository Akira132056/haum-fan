<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HAUM 郭河音 · 夏日入坑安利站 | 하음 입덕 가이드</title>
<meta name="description" content="KiiiKiii Haum（곽하음）中文安利站 — 个人介绍、概念照、直拍、Cover舞台、直播、TMI">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;700;900&family=Noto+Sans+KR:wght@300;400;500;700;900&family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#fffaf3;--bg-alt:#fff5e6;--card:#ffffff;
  --coral:#ff6b4a;--peach:#ff9a76;--sun:#ffc93c;
  --sky:#4ec3f7;--mint:#3ddc97;--grape:#a855f7;
  --text:#2d2a26;--dim:#8a8279;
  --line:rgba(45,42,38,.1);--radius:16px;
  --shadow:0 8px 30px -10px rgba(255,107,74,.2);
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  background:var(--bg);color:var(--text);
  font-family:'Noto Sans SC','Noto Sans KR','PingFang SC','Malgun Gothic',sans-serif;
  line-height:1.6;letter-spacing:.03em;overflow-x:hidden;
}
.ko,[lang="ko"]{word-break:keep-all;letter-spacing:.02em;}
::-webkit-scrollbar{width:10px;}
::-webkit-scrollbar-track{background:var(--bg-alt);}
::-webkit-scrollbar-thumb{background:linear-gradient(var(--coral),var(--sun));border-radius:6px;}
::selection{background:var(--sun);color:#2d2a26;}
body::before{
  content:'';position:fixed;inset:0;
  background:
    radial-gradient(circle at 15% 20%, rgba(255,201,60,.08) 0%, transparent 50%),
    radial-gradient(circle at 85% 70%, rgba(78,195,247,.06) 0%, transparent 50%),
    radial-gradient(circle at 50% 50%, rgba(255,107,74,.04) 0%, transparent 60%);
  pointer-events:none;z-index:0;
}
nav{
  position:sticky;top:0;z-index:100;
  background:rgba(255,250,243,.92);backdrop-filter:blur(16px);
  border-bottom:2px solid rgba(255,201,60,.3);
}
.nav-inner{
  max-width:1200px;margin:0 auto;padding:12px 20px;
  display:flex;align-items:center;gap:22px;
  overflow-x:auto;scrollbar-width:none;
}
.nav-inner::-webkit-scrollbar{display:none;}
.nav-logo{
  font-weight:900;font-size:1.05rem;letter-spacing:.08em;
  color:var(--coral);white-space:nowrap;flex-shrink:0;
  text-shadow:0 2px 8px rgba(255,107,74,.25);
}
.nav-links{display:flex;gap:18px;list-style:none;}
.nav-links a{
  color:var(--dim);text-decoration:none;font-size:.82rem;
  white-space:nowrap;padding:4px 0;position:relative;
  transition:color .25s;display:flex;flex-direction:column;line-height:1.25;
}
.nav-links a .ko{font-size:.72rem;opacity:.6;}
.nav-links a:hover,.nav-links a.active{color:var(--coral);}
.nav-links a::after{
  content:'';position:absolute;left:0;bottom:-2px;width:0;height:3px;
  border-radius:2px;background:linear-gradient(90deg,var(--coral),var(--sun));
  transition:width .3s;
}
.nav-links a:hover::after,.nav-links a.active::after{width:100%;}
section{
  position:relative;z-index:1;max-width:1200px;
  margin:0 auto;padding:88px 20px;scroll-margin-top:70px;
}
.sec-head{margin-bottom:44px;}
.sec-num{
  font-family:'Press Start 2P',monospace;font-size:.6rem;
  color:var(--coral);letter-spacing:.1em;display:block;margin-bottom:12px;
}
.sec-title{font-size:clamp(1.7rem,4.5vw,2.7rem);font-weight:900;line-height:1.2;color:var(--text);}
.sec-title .hl{
  background:linear-gradient(92deg,var(--coral),var(--sun));
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
}
.sec-sub{color:var(--dim);font-size:.9rem;margin-top:8px;font-weight:400;}
.sec-line{
  height:3px;width:80px;margin-top:18px;border-radius:2px;
  background:linear-gradient(90deg,var(--coral),var(--sun),transparent);
}
.hero{
  max-width:none;padding:0;min-height:88vh;
  display:flex;align-items:center;justify-content:center;
  position:relative;overflow:hidden;
  background:linear-gradient(160deg,#fff5e6 0%,#ffe8d6 40%,#e6f6ff 100%);
}
.hero-glow{position:absolute;border-radius:50%;filter:blur(100px);opacity:.35;}
.hero-glow.g1{width:400px;height:400px;background:var(--sun);top:-80px;left:-60px;}
.hero-glow.g2{width:360px;height:360px;background:var(--sky);bottom:-100px;right:-50px;}
.hero-glow.g3{width:240px;height:240px;background:var(--peach);top:50%;left:55%;opacity:.25;}
.hero-content{position:relative;z-index:2;text-align:center;padding:80px 20px;max-width:900px;}
.hero-tag{
  display:inline-block;font-size:.7rem;letter-spacing:.22em;
  color:var(--coral);border:2px solid rgba(255,107,74,.35);
  padding:6px 18px;border-radius:100px;margin-bottom:26px;
  background:rgba(255,255,255,.7);
}
.hero-name{
  font-size:clamp(3.2rem,12vw,7rem);font-weight:900;line-height:.95;
  letter-spacing:.02em;color:var(--text);
}
.hero-name .accent{
  background:linear-gradient(92deg,var(--coral),var(--sun),var(--sky));
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
}
.hero-ko{font-size:clamp(1rem,3.2vw,1.5rem);color:var(--dim);margin-top:14px;font-weight:500;}
.hero-desc{margin-top:26px;font-size:.92rem;color:var(--dim);max-width:520px;margin-left:auto;margin-right:auto;}
.hero-meta{margin-top:34px;display:flex;flex-wrap:wrap;gap:10px;justify-content:center;}
.hero-chip{
  font-size:.74rem;padding:8px 16px;border-radius:100px;
  border:1px solid rgba(45,42,38,.1);background:rgba(255,255,255,.8);
  color:var(--text);box-shadow:0 2px 10px rgba(0,0,0,.04);
}
.hero-chip b{color:var(--coral);font-weight:700;}
.hero-photo{
  position:relative;z-index:2;margin:0 auto 28px;
  width:200px;height:200px;border-radius:50%;
  overflow:hidden;border:4px solid #fff;
  box-shadow:0 12px 40px -8px rgba(255,107,74,.35), 0 0 0 8px rgba(255,201,60,.15);
  background:#fff5e6;
}
.hero-photo img{
  width:100%;height:100%;
  object-fit:cover;
  object-position:center 25%;
  display:block;
}
.hero-photo-glow{
  position:absolute;inset:-10px;border-radius:50%;
  background:radial-gradient(circle,rgba(255,201,60,.3),transparent 70%);
  z-index:-1;animation:pulse 4s ease-in-out infinite;
}
.sun-deco{
  position:absolute;right:6%;top:16%;width:120px;height:120px;border-radius:50%;
  background:radial-gradient(circle,var(--sun) 0%,var(--peach) 60%,transparent 70%);
  opacity:.5;animation:pulse 4s ease-in-out infinite;z-index:1;
}
@keyframes pulse{0%,100%{transform:scale(1);opacity:.5;}50%{transform:scale(1.15);opacity:.7;}}
.wave{position:absolute;bottom:-2px;left:0;width:100%;height:60px;z-index:3;}
.wave svg{display:block;width:100%;height:100%;}
.quick-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:16px;margin-bottom:52px;
}
.quick-card{
  background:var(--card);border:1px solid rgba(255,201,60,.25);
  border-radius:var(--radius);padding:22px 20px;
  transition:transform .3s,box-shadow .3s;
  position:relative;overflow:hidden;
  box-shadow:0 4px 20px -8px rgba(255,107,74,.1);
}
.quick-card::before{
  content:'';position:absolute;top:0;left:0;width:100%;height:4px;
  background:linear-gradient(90deg,var(--coral),var(--sun));
  transform:scaleX(0);transform-origin:left;transition:transform .35s;
  border-radius:4px 4px 0 0;
}
.quick-card:hover{transform:translateY(-5px);box-shadow:0 12px 30px -10px rgba(255,107,74,.25);}
.quick-card:hover::before{transform:scaleX(1);}
.quick-icon{font-size:1.6rem;margin-bottom:12px;display:block;}
.quick-card h4{font-size:.94rem;font-weight:700;margin-bottom:6px;color:var(--text);}
.quick-card .ko{font-size:.78rem;color:var(--dim);display:block;font-weight:400;}
.top5-title{
  font-size:1.15rem;font-weight:800;margin-bottom:22px;
  display:flex;align-items:center;gap:10px;
}
.top5-title::before{
  content:'';width:5px;height:22px;border-radius:3px;
  background:linear-gradient(var(--coral),var(--sun));
}
.top5-list{display:flex;flex-direction:column;gap:12px;}
.top5-item{
  display:flex;gap:18px;align-items:flex-start;
  background:var(--card);border:1px solid rgba(255,201,60,.2);
  border-left:4px solid var(--sun);border-radius:12px;padding:18px 20px;
  transition:transform .25s,box-shadow .25s;
  box-shadow:0 2px 12px -6px rgba(0,0,0,.05);
}
.top5-item:hover{transform:translateX(5px);box-shadow:0 6px 20px -8px rgba(255,107,74,.2);}
.top5-rank{
  font-family:'Press Start 2P',monospace;font-size:.9rem;
  color:var(--coral);flex-shrink:0;padding-top:3px;
}
.top5-body h5{font-size:.95rem;font-weight:700;margin-bottom:5px;color:var(--text);}
.top5-body p{font-size:.82rem;color:var(--dim);}
.top5-body .ko{display:block;font-size:.78rem;color:rgba(138,130,121,.7);margin-top:3px;}
.about-block{
  margin-bottom:52px;display:grid;
  grid-template-columns:52px 1fr;gap:22px;align-items:start;
}
.about-num{font-family:'Press Start 2P',monospace;font-size:.72rem;color:var(--coral);padding-top:8px;}
.about-body h3{font-size:1.15rem;font-weight:800;margin-bottom:6px;color:var(--coral);}
.about-body h3 .ko{display:block;font-size:.82rem;color:var(--dim);font-weight:400;margin-top:2px;}
.about-body p{font-size:.9rem;color:rgba(45,42,38,.8);margin-top:12px;}
.about-body p.ko{font-size:.82rem;color:rgba(45,42,38,.5);margin-top:6px;}

/* ============ 概念照 ============ */
.concept-tabs{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:22px;}
.concept-tab{
  padding:10px 20px;border-radius:100px;border:2px solid rgba(255,201,60,.3);
  background:rgba(255,255,255,.7);color:var(--dim);font-size:.8rem;
  cursor:pointer;transition:all .25s;font-family:inherit;
  display:flex;flex-direction:column;align-items:center;line-height:1.3;
}
.concept-tab .ko{font-size:.7rem;opacity:.65;}
.concept-tab:hover{color:var(--coral);border-color:var(--coral);}
.concept-tab.active{
  background:linear-gradient(92deg,var(--coral),var(--peach));
  color:#fff;font-weight:700;border-color:transparent;
  box-shadow:0 6px 20px -6px rgba(255,107,74,.5);
}
.concept-tab.active .ko{opacity:.85;color:#fff;}

.concept-viewer{display:flex;flex-direction:column;gap:14px;}

.concept-selector{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:6px;}
.concept-chip{
  padding:8px 16px;border-radius:100px;
  border:1.5px solid rgba(255,201,60,.35);
  background:rgba(255,255,255,.75);
  color:var(--dim);font-size:.76rem;
  cursor:pointer;transition:all .22s;
  font-family:inherit;
  display:flex;flex-direction:column;align-items:center;line-height:1.3;
}
.concept-chip .ko{font-size:.64rem;opacity:.6;}
.concept-chip:hover{color:var(--coral);border-color:var(--coral);}
.concept-chip.active{
  background:linear-gradient(92deg,var(--coral),var(--peach));
  color:#fff;font-weight:700;border-color:transparent;
  box-shadow:0 4px 14px -4px rgba(255,107,74,.5);
}
.concept-chip.active .ko{opacity:.85;color:#fff;}

.concept-cover{
  position:relative;width:100%;aspect-ratio:16/10;
  border-radius:var(--radius);overflow:hidden;
  border:2px solid rgba(255,201,60,.2);background:var(--bg-alt);
  box-shadow:var(--shadow);
  display:flex;align-items:center;justify-content:center;
}
.concept-cover img{
  width:100%;height:100%;
  object-fit:cover;
  object-position:center 22%;
  display:block;
}
.concept-cover .ph{
  width:100%;height:100%;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:8px;text-align:center;padding:24px;
}
.concept-cover .ph .ph-title{
  font-size:clamp(1.2rem,3.5vw,1.8rem);font-weight:900;color:#fff;
  text-shadow:0 2px 18px rgba(0,0,0,.5);
}
.concept-cover .ph .ph-sub{
  font-size:.8rem;color:rgba(255,255,255,.9);max-width:520px;
}
.concept-info{
  display:grid;grid-template-columns:1fr auto;gap:20px;align-items:center;
  background:var(--card);border:1px solid rgba(255,201,60,.25);
  border-radius:var(--radius);padding:20px 22px;
  box-shadow:0 4px 20px -10px rgba(255,107,74,.1);
}
.concept-desc{font-size:.84rem;color:rgba(45,42,38,.8);line-height:1.7;}
.concept-desc .ko{display:block;color:rgba(45,42,38,.5);font-size:.76rem;margin-top:6px;}
.btn-weibo{
  display:inline-flex;align-items:center;gap:8px;
  padding:12px 24px;border-radius:100px;
  background:linear-gradient(92deg,var(--coral),var(--peach));
  color:#fff;font-weight:700;font-size:.82rem;
  text-decoration:none;white-space:nowrap;
  box-shadow:0 8px 20px -8px rgba(255,107,74,.6);
  transition:transform .25s,box-shadow .25s;
}
.btn-weibo:hover{
  transform:translateY(-2px);
  box-shadow:0 12px 26px -8px rgba(255,107,74,.8);
}
.btn-weibo .ko{font-size:.68rem;opacity:.85;font-weight:400;}

@media(max-width:768px){
  .concept-cover{aspect-ratio:4/5;}
  .concept-cover img{object-position:center 20%;}
  .concept-info{grid-template-columns:1fr;gap:14px;}
  .btn-weibo{justify-content:center;width:100%;}
}

/* ============ 直拍 ============ */
.fancam-tabs{display:flex;gap:12px;margin-bottom:28px;flex-wrap:wrap;}
.fancam-tab{
  padding:12px 28px;border-radius:100px;border:2px solid rgba(255,201,60,.3);
  background:rgba(255,255,255,.7);color:var(--dim);font-size:.86rem;
  font-weight:600;cursor:pointer;font-family:inherit;transition:all .25s;
}
.fancam-tab:hover{color:var(--coral);border-color:var(--coral);}
.fancam-tab.active{
  background:var(--coral);color:#fff;border-color:transparent;
  box-shadow:0 6px 20px -6px rgba(255,107,74,.5);
}
details.song{
  border:1px solid rgba(255,201,60,.25);border-radius:14px;
  margin-bottom:12px;background:var(--card);overflow:hidden;
  transition:border-color .25s;box-shadow:0 2px 12px -8px rgba(0,0,0,.06);
}
details.song[open]{border-color:rgba(255,107,74,.35);}
details.song summary{
  padding:16px 20px;cursor:pointer;list-style:none;
  display:flex;align-items:center;justify-content:space-between;
  gap:12px;font-weight:700;font-size:.94rem;transition:background .2s;
}
details.song summary::-webkit-details-marker{display:none;}
details.song summary:hover{background:rgba(255,201,60,.08);}
.summary-left{display:flex;align-items:center;gap:12px;}
.summary-left .dot{
  width:10px;height:10px;border-radius:50%;
  background:linear-gradient(135deg,var(--coral),var(--sun));flex-shrink:0;
}
.summary-left .ko{font-size:.74rem;color:var(--dim);font-weight:400;display:block;}
.summary-arrow{color:var(--coral);font-size:.9rem;transition:transform .3s;}
details[open] .summary-arrow{transform:rotate(180deg);}
.cam-list{padding:6px 20px 20px;display:flex;flex-direction:column;gap:12px;}
.cam-item{
  display:flex;gap:16px;align-items:center;background:var(--bg-alt);
  border-radius:12px;padding:12px;transition:background .25s,transform .25s,box-shadow .25s;
  text-decoration:none;color:inherit;border:1px solid transparent;
}
.cam-item:hover{
  background:#fff;border-color:rgba(255,107,74,.2);
  transform:translateX(4px);box-shadow:0 4px 16px -6px rgba(255,107,74,.15);
}
.cam-thumb{
  width:104px;height:62px;flex-shrink:0;border-radius:9px;
  display:flex;align-items:center;justify-content:center;
  font-size:1.2rem;position:relative;overflow:hidden;background:#f0ebe3;
}
.cam-thumb img{width:100%;height:100%;object-fit:cover;display:block;}
.cam-thumb::after{content:'';position:absolute;inset:0;background:rgba(0,0,0,.12);pointer-events:none;}
.cam-thumb span{position:relative;z-index:2;}
.cam-info{flex:1;min-width:0;}
.cam-info h5{
  font-size:.86rem;font-weight:700;margin-bottom:4px;
  display:flex;align-items:center;gap:8px;flex-wrap:wrap;
}
.cam-date{
  font-family:'Press Start 2P',monospace;font-size:.5rem;color:var(--coral);
  background:rgba(255,107,74,.1);padding:3px 7px;border-radius:4px;
  border:1px solid rgba(255,107,74,.2);
}
.cam-play{
  font-family:'Press Start 2P',monospace;font-size:.5rem;color:var(--mint);
  background:rgba(61,220,151,.12);padding:3px 7px;border-radius:4px;
  border:1px solid rgba(61,220,151,.25);
}
.cam-type{
  font-size:.66rem;padding:3px 10px;border-radius:100px;
  background:rgba(255,201,60,.15);color:#b8860b;
  border:1px solid rgba(255,201,60,.3);
}
.cam-info p{font-size:.76rem;color:var(--dim);}
.cam-info p .ko{display:block;color:rgba(138,130,121,.65);font-size:.72rem;}
.cam-go{
  font-size:.7rem;color:var(--coral);border:1.5px solid rgba(255,107,74,.4);
  padding:6px 14px;border-radius:100px;white-space:nowrap;flex-shrink:0;
  transition:all .25s;
}
.cam-item:hover .cam-go{background:var(--coral);color:#fff;font-weight:700;}

/* ============ Cover ============ */
.cover-list{display:flex;flex-direction:column;gap:26px;}
.cover-card{
  background:var(--card);border:1px solid rgba(255,201,60,.25);
  border-radius:var(--radius);overflow:hidden;
  transition:box-shadow .3s;box-shadow:0 4px 20px -10px rgba(255,107,74,.1);
}
.cover-card:hover{box-shadow:0 16px 40px -16px rgba(255,107,74,.25);}
.cover-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);}
@media(max-width:820px){.cover-grid{grid-template-columns:1fr;}}
.cover-video{
  position:relative;aspect-ratio:16/9;background:#f0ebe3;
  display:flex;align-items:center;justify-content:center;overflow:hidden;
}
.cover-video img{
  width:100%;height:100%;object-fit:cover;display:block;
}
.cover-video iframe{width:100%;height:100%;border:0;display:block;}
.cover-body{padding:24px 24px 26px;display:flex;flex-direction:column;}
.cover-index{
  font-family:'Press Start 2P',monospace;font-size:.56rem;
  color:var(--coral);letter-spacing:.1em;margin-bottom:10px;
}
.cover-body h4{font-size:1.08rem;font-weight:800;margin-bottom:4px;color:var(--text);}
.cover-body h4 .ko{display:block;font-size:.78rem;color:var(--dim);font-weight:400;margin-top:3px;}
.why{
  margin-top:16px;background:rgba(255,201,60,.1);
  border-left:3px solid var(--sun);border-radius:0 10px 10px 0;padding:14px 16px;
}
.why-label{font-size:.68rem;font-weight:800;color:var(--coral);letter-spacing:.12em;display:block;margin-bottom:8px;}
.why p{font-size:.82rem;color:rgba(45,42,38,.8);}
.why p.ko{font-size:.76rem;color:rgba(45,42,38,.5);margin-top:7px;}
.cover-actions{margin-top:auto;padding-top:20px;display:flex;gap:10px;flex-wrap:wrap;}
.btn-out{
  display:inline-flex;align-items:center;gap:7px;font-size:.76rem;font-weight:600;
  padding:10px 20px;border-radius:100px;border:1.5px solid var(--coral);
  color:var(--coral);text-decoration:none;transition:all .25s;
}
.btn-out:hover{background:var(--coral);color:#fff;box-shadow:0 6px 18px -6px rgba(255,107,74,.5);}

/* ============ 直播 ============ */
.live-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:18px;}
.live-card{
  background:var(--card);border:1px solid rgba(78,195,247,.25);
  border-radius:var(--radius);overflow:hidden;
  transition:transform .3s,box-shadow .3s;
  box-shadow:0 4px 20px -10px rgba(78,195,247,.15);
}
.live-card:hover{transform:translateY(-5px);box-shadow:0 14px 36px -14px rgba(78,195,247,.3);}
.live-thumb{
  aspect-ratio:16/9;position:relative;display:flex;
  align-items:center;justify-content:center;font-size:2rem;overflow:hidden;
  background-size:cover;background-position:center;
}
.live-thumb::after{content:'';position:absolute;inset:0;background:rgba(0,0,0,.15);}
.live-thumb .live-badge{
  position:absolute;top:12px;left:12px;z-index:3;
  font-family:'Press Start 2P',monospace;font-size:.5rem;
  background:var(--coral);color:#fff;padding:4px 10px;border-radius:6px;
}
.live-thumb .live-dur{
  position:absolute;bottom:12px;right:12px;z-index:3;
