/* ============ 状态 ============ */
let currentCat = 'album';
let currentConcept = 0;

const elSelector = document.getElementById('conceptSelector');
const elCover    = document.getElementById('conceptCover');
const elDesc     = document.getElementById('conceptDesc');
const elWeibo    = document.getElementById('conceptWeibo');

/* ============ 渲染选择器 ============ */
function renderSelector(){
  const list = conceptData[currentCat];
  elSelector.innerHTML = list.map((c, i) => `
    <button class="concept-chip ${i===currentConcept?'active':''}" data-idx="${i}">
      <span>${c.title}</span>
      <span class="ko">${c.titleKo}</span>
    </button>
  `).join('');

  elSelector.querySelectorAll('.concept-chip').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      currentConcept = parseInt(btn.dataset.idx, 10);
      renderConcept();
    });
  });
}

/* ============ 主渲染 ============ */
function renderConcept(){
  const concept = conceptData[currentCat][currentConcept];

  if(concept.cover){
    elCover.innerHTML = `<img src="${concept.cover}" alt="${concept.title}">`;
  }else{
    elCover.innerHTML = `
      <div class="ph" style="background:${concept.color};">
        <div class="ph-title">${concept.title}</div>
        <div class="ph-sub">此处等待 Haum 的封面图</div>
      </div>`;
  }

  elDesc.innerHTML = `${concept.desc}<span class="ko">${concept.descKo}</span>`;
  elWeibo.href = concept.weibo || '#';
  renderSelector();
}

/* ============ 分类切换 ============ */
document.getElementById('conceptTabs').addEventListener('click', e=>{
  const btn = e.target.closest('.concept-tab');
  if(!btn) return;
  document.querySelectorAll('.concept-tab').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  currentCat = btn.dataset.cat;
  currentConcept = 0;
  renderConcept();
});

renderConcept();

