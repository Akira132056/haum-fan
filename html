/* ============ TMI ============ */
.tmi-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;}
.tmi-card{perspective:1100px;height:176px;cursor:pointer;}
.tmi-inner{
  position:relative;width:100%;height:100%;
  transition:transform .65s cubic-bezier(.4,.2,.2,1);transform-style:preserve-3d;
}
.tmi-card.flipped .tmi-inner{transform:rotateY(180deg);}
.tmi-face{
  position:absolute;inset:0;backface-visibility:hidden;
  -webkit-backface-visibility:hidden;border-radius:14px;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;padding:18px 16px;border:1px solid rgba(255,201,60,.2);
}
.tmi-front{background:linear-gradient(145deg,#fff9f0,#fff0e0);}
.tmi-front::before{
  content:'?';position:absolute;top:10px;right:16px;
  font-family:'Press Start 2P',monospace;font-size:1.1rem;
  color:rgba(255,107,74,.2);
}
.tmi-front h5{font-size:.9rem;font-weight:700;line-height:1.45;color:var(--text);}
.tmi-front .ko{font-size:.76rem;color:var(--dim);margin-top:6px;font-weight:400;}
.tmi-back{
  transform:rotateY(180deg);
  background:linear-gradient(145deg,rgba(255,201,60,.2),rgba(255,107,74,.15));
  border-color:rgba(255,107,74,.35);
}
.tmi-back p{font-size:.86rem;font-weight:700;line-height:1.5;color:var(--text);}
.tmi-back .ko{font-size:.74rem;color:rgba(45,42,38,.6);margin-top:7px;font-weight:400;}
.tmi-hint{font-size:.68rem;color:var(--dim);text-align:center;margin-bottom:22px;}

/* ============ 页脚 ============ */
footer{
